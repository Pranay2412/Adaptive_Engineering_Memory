      "title": "Synapse Platform Overview & Key Performance Indicators",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "API Request Throughput by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(synapse_requests_total[1m]))",
          "legendFormat": "{{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "ACO Context Budget Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "synapse_context_budget_utilization_ratio * 100",
          "legendFormat": "Budget Utilization"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Token Economics & ACO Optimization Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "Context vs Input Token Accounting",
      "type": "timeseries",
      "targets": [
        {
          "expr": "synapse_context_tokens",
          "legendFormat": "Knowledge Context Tokens (Section 7)"
        },
        {
          "expr": "synapse_total_input_tokens",
          "legendFormat": "Total Input Tokens (Envelope)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "ACO Pipeline Stage Latency (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (stage) (rate(synapse_stage_latency_seconds_sum[1m]) / rate(synapse_stage_latency_seconds_count[1m]))",
          "legendFormat": "Stage: {{stage}}"
        }
      ]
    }
