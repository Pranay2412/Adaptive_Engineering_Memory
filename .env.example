# ==============================================================================
# Adaptive Engineering Memory - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values.
# NEVER commit the actual .env file or real secrets to source control.

# ------------------------------------------------------------------------------
# Neo4j Graph Database Configuration
# ------------------------------------------------------------------------------
# Bolt connection URI, user credentials, and database name
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
# NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# LLM & Extraction Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: openai, gemini, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-your-openai-api-key

# ------------------------------------------------------------------------------
# Google Gemini Configuration (Alternative to OpenAI)
# ------------------------------------------------------------------------------
# To use Gemini instead of OpenAI, uncomment below:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=replace-with-your-gemini-api-key

# ------------------------------------------------------------------------------
# Embedding Provider Configuration (Dense Vector Search & Semantic Cross-Linking)
# ------------------------------------------------------------------------------
# Provider used for semantic candidate retrieval and hybrid search: openai | gemini | mock
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_API_KEY=replace-if-different-from-llm-key
# EMBEDDING_DIMENSION=1536
# EMBEDDING_BATCH_SIZE=128

# ------------------------------------------------------------------------------
# Cognee System Database Directory
# ------------------------------------------------------------------------------
# Absolute path to Cognee's local relational/metadata storage.
# SYSTEM_ROOT_DIRECTORY=C:\path\to\.cognee_system
