# ==============================================================================
# Synapse: Adaptive Engineering Memory Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# NEVER commit the actual .env file or real secrets to source control.

# ------------------------------------------------------------------------------
# 1. FastAPI Service Configuration (Phase 10)
# ------------------------------------------------------------------------------
# Runtime Environment Mode: development | staging | production | testing
SYNAPSE_ENV=development

# Network Bind Host and Port
SYNAPSE_HOST=127.0.0.1
SYNAPSE_PORT=8000

# Cryptographic Secret Key for HMAC-SHA256 Token Signing
# CRITICAL: In production, this MUST be set to a secure, randomly generated string of at least 32 characters.
SYNAPSE_SECRET_KEY=synapse-insecure-dev-secret-key-32chars-min-length-12345

# Enforce Authentication (true | false)
# When set to true, requests without a valid Bearer token or API key will immediately receive 401 Unauthorized.
SYNAPSE_REQUIRE_AUTH=false

# SQLite Database File Path or PostgreSQL Connection URI
SYNAPSE_DB_PATH=data/synapse_team_memory.db

# Allowed CORS Origins (comma-separated list)
# Example: https://app.synapse.internal,http://localhost:3000
SYNAPSE_CORS_ORIGINS=*

# Request Timeout in Seconds
SYNAPSE_REQUEST_TIMEOUT=30.0

# Maximum Allowed Request Payload in Bytes (default: 10485760 = 10 MB)
SYNAPSE_MAX_PAYLOAD_BYTES=10485760

# Structured Logging Level: DEBUG | INFO | WARNING | ERROR
SYNAPSE_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Multi-Service Docker Port Mappings (Avoids Host Port Conflicts)
# ------------------------------------------------------------------------------
SYNAPSE_PORT=8088
SYNAPSE_MCP_PORT=8081
POSTGRES_PORT=5435
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
POSTGRES_PASSWORD=synapse_secure_db_pass_123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=synapse_grafana_pass

# ------------------------------------------------------------------------------
# 3. Neo4j Graph Database Configuration
# ------------------------------------------------------------------------------
# Bolt connection URI, user credentials, and database name
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
# NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 4. LLM & Extraction Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: openai, gemini, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-your-openai-api-key

# Google Gemini Configuration (Alternative to OpenAI)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=replace-with-your-gemini-api-key

# ------------------------------------------------------------------------------
# 5. Embedding Provider Configuration (Dense Vector Search & Semantic Cross-Linking)
# ------------------------------------------------------------------------------
# Provider used for semantic candidate retrieval and hybrid search: openai | gemini | mock
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_API_KEY=replace-if-different-from-llm-key
# EMBEDDING_DIMENSION=1536
# EMBEDDING_BATCH_SIZE=128

# ------------------------------------------------------------------------------
# 6. Cognee System & Team Memory Storage
# ------------------------------------------------------------------------------
# Absolute path to Cognee's local relational/metadata storage.
# SYSTEM_ROOT_DIRECTORY=C:\path\to\.cognee_system
# Local SQLite document store database path (default: data/team_memory.db or in-memory)
TEAM_MEMORY_DB_PATH=data/team_memory.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/team_memory
# Whether AI sessions should store raw conversation transcripts (default: false for high-signal storage)
STORE_RAW_TRANSCRIPTS=false
